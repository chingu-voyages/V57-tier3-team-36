DATABASE_URL=postgres://username:password@localhost:5432/dbname
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_personal_access_token * see https://docs.github.com/en/authentication/keeping-your-account-and-data-secure/managing-your-personal-access-tokens

GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=your_random_secret_key

ENABLE_API_MOCKING=true
