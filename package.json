{
  "name": "v57-tier3-team-36",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "prod": "next build && next start",
    "lint": "prettier --check . && eslint",
    "tsc": "tsc --noEmit",
    "test": "playwright test --project=chromium",
    "test:setup": "playwright test --project=setup",
    "setup:msw": "msw init public/ --save",
    "setup:playwright": "playwright install chromium",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "dotenvx run -f .env.local -- npx drizzle-kit push",
    "db:migrate:test": "dotenvx run -f .env.test -- npx drizzle-kit push",
    "db:deploy": "dotenvx run -f .env -- npx drizzle-kit migrate"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.1",
    "better-auth": "^1.3.9",
    "drizzle-orm": "^0.44.5",
    "next": "15.5.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "uuid": "^13.0.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.51.0",
    "@eslint/eslintrc": "^3.3.1",
    "@octokit/openapi-types": "^25.1.0",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "^20.19.13",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "clsx": "^2.1.1",
    "daisyui": "5.1.10",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.35.0",
    "eslint-config-next": "15.5.2",
    "eslint-config-prettier": "^10.1.8",
    "msw": "^2.11.2",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
